# Base de donnees
DATABASE_URL="postgresql://user:password@localhost:5432/scolaire?schema=public"

# Auth.js
AUTH_SECRET="genere avec: npx auth secret"
AUTH_URL="http://localhost:3000"

# ZITADEL (OIDC) - creer une application dans la console ZITADEL
# Callback a enregistrer : http://localhost:3000/api/auth/callback/zitadel
ZITADEL_CLIENT_ID=""
ZITADEL_CLIENT_SECRET=""
ZITADEL_ISSUER="https://your-instance-xxxxx.zitadel.cloud"

# Compte administrateur initial (cf. cahier des charges section 2)
ADMIN_EMAIL_INITIAL="me@taiga34.fr"

# Cle de chiffrement (AES-256-GCM) des tokens Scolengo stockes en base.
# Generer avec: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SCOLENGO_ENCRYPTION_KEY=""

# Notifications (section 8) : rappels de controles.
# NOTIFICATIONS_CRON_SECRET protege la route /api/notifications/verifier,
# a appeler par une tache planifiee externe (crontab), ex:
#   */10 * * * * curl -fsS -H "Authorization: Bearer $NOTIFICATIONS_CRON_SECRET" https://votre-domaine/api/notifications/verifier
# Generer avec: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
NOTIFICATIONS_CRON_SECRET=""

# SMTP pour l'envoi des rappels par email (n'importe quel relais SMTP convient)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
