// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  UTILISATEUR
}

enum Provenance {
  MBN
  MANUEL
}

enum StatutDevoir {
  A_FAIRE
  TERMINE
}

enum StatutControle {
  A_VENIR
  PASSE
}

enum TypeControle {
  MANUEL
  AUTOMATIQUE
}

enum CanalNotification {
  NAVIGATEUR
  EMAIL
  MOBILE
}

enum TypeRappel {
  J_MOINS_14
  J_MOINS_7
  J_MOINS_3
  J_MOINS_2
  VEILLE
  MATIN_MEME
  PERSONNALISE
}

enum FournisseurNotification {
  PUSHOVER
  NTFY
  GOTIFY
  AUTRE
}

enum StatutSynchronisation {
  EN_COURS
  SUCCES
  ECHEC
}

enum FrequenceSynchronisation {
  MANUELLE
  HORAIRE
  TOUTES_LES_6H
  QUOTIDIENNE
}

// ---------------------------------------------------------------------------
// Utilisateur
// ---------------------------------------------------------------------------

model Utilisateur {
  id        String @id @default(cuid())
  zitadelSub String @unique // OIDC "sub" claim, source of truth for identity
  email     String @unique
  nom       String?
  role      Role   @default(UTILISATEUR)
  actif     Boolean @default(true)
  modeDeveloppeur Boolean @default(false)
  // Masque les informations personnelles a l'affichage (nom de l'etablissement,
  // nom/email du compte, noms des enseignants) sans rien changer en base.
  modeStreamer    Boolean @default(false)

  // Connexion MonBureauNumerique
  scolengoTokenChiffre String? // token Scolengo, stocke chiffre
  fuseauHoraire        String  @default("Europe/Paris")
  frequenceSynchronisation FrequenceSynchronisation @default(MANUELLE)

  // Detection automatique des controles (mots-cles configurables par utilisateur)
  motsClesControle String[] @default(["controle", "controle", "evaluation", "evaluation", "interrogation", "interro", "devoir surveille", "ds", "examen", "test", "quiz"])

  // Rappels generes automatiquement pour chaque nouveau controle (section 8)
  rappelsParDefaut TypeRappel[]        @default([J_MOINS_3, VEILLE])
  canauxParDefaut  CanalNotification[] @default([EMAIL, MOBILE])

  // Rappels generes automatiquement pour chaque devoir non termine.
  // Par defaut : 2 jours avant, la veille (18h) et le matin meme (6h30).
  rappelsDevoirParDefaut TypeRappel[]        @default([J_MOINS_2, VEILLE, MATIN_MEME])
  canauxDevoirParDefaut  CanalNotification[] @default([EMAIL, MOBILE])

  preferencesAffichage Json?

  // Deconnexion back-channel ZITADEL sans "sid" : toute session de l'app
  // ouverte avant cette date est refusee (voir api/zitadel/deconnexion).
  sessionsRevoqueesLe DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matieres          Matiere[]
  devoirs           Devoir[]
  controles         Controle[]
  notes             Note[]
  chapitres         Chapitre[]
  notifications     Notification[]
  parametresNotif   ParametreNotification[]
  synchronisations  Synchronisation[]
  journaux          Journal[]
  documents         Document[]
  rappelsPersonnalises Rappel[]

  // Emploi du temps synchronise depuis MonBureauNumerique (seances datees).
  seancesEmploiDuTemps SeanceEmploiDuTemps[]

  @@map("utilisateurs")
}

// Email pre-autorise par un administrateur : aucun formulaire d'inscription
// n'existe, mais l'authentification ZITADEL a elle seule ne suffit pas a
// obtenir un compte local tant que l'email n'a pas ete ajoute ici (sauf pour
// l'admin initial). L'entree est consommee (supprimee) a la premiere connexion.
model EmailAutorise {
  id        String   @id @default(cuid())
  email     String   @unique
  role      Role     @default(UTILISATEUR)
  ajoutePar String?
  createdAt DateTime @default(now())

  @@map("emails_autorises")
}

// ---------------------------------------------------------------------------
// Matiere / Chapitre
// ---------------------------------------------------------------------------

model Matiere {
  id            String @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  nom       String
  couleur   String?
  externalId String? // identifiant MBN pour reconciliation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devoirs   Devoir[]
  controles Controle[]
  notes     Note[]
  chapitres Chapitre[]
  rappelsPersonnalises Rappel[]

  @@unique([utilisateurId, nom])
  @@map("matieres")
}

// Le chapitre EST la page de contenu (composee de blocs ordonnes), plutot
// qu'un simple regroupement de "cours" separes.
model Chapitre {
  id            String @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  matiereId String
  matiere   Matiere @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  nom String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blocs     BlocCours[]
  controles ControleChapitre[]

  @@unique([matiereId, nom])
  @@map("chapitres")
}

// ---------------------------------------------------------------------------
// Devoir
// ---------------------------------------------------------------------------

model Devoir {
  id            String @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  matiereId String
  matiere   Matiere @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  enseignant  String?
  date        DateTime
  heure       String?
  titre       String
  description String?
  statut      StatutDevoir @default(A_FAIRE)
  provenance  Provenance   @default(MANUEL)
  externalId  String?      // identifiant MBN pour reconciliation lors des sync

  // Pieces jointes MBN : liste { id, nom, typeMime, taille, url }, remplacee a
  // chaque synchronisation. Les fichiers restent sur MBN et sont servis via
  // /api/pieces-jointes (le telechargement exige le jeton Scolengo).
  piecesJointes Json?

  // Lorsqu'un mot-cle est detecte, le devoir donne naissance a un Controle.
  controleGenere Controle?

  documents Document[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("devoirs")
}

// ---------------------------------------------------------------------------
// Controle
// ---------------------------------------------------------------------------

model Controle {
  id            String @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  matiereId String
  matiere   Matiere @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  // Present uniquement si le controle a ete genere depuis un devoir synchronise.
  devoirSourceId String? @unique
  devoirSource   Devoir? @relation(fields: [devoirSourceId], references: [id], onDelete: SetNull)

  date       DateTime
  heure      String?
  chapitreLibre String? // libelle de chapitre libre, distinct de la bibliotheque de cours
  commentaire   String?
  statut     StatutControle @default(A_VENIR)
  type       TypeControle   @default(MANUEL)

  note      Note?
  chapitres ControleChapitre[]
  documents Document[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("controles")
}

// ---------------------------------------------------------------------------
// Note / Copie
// ---------------------------------------------------------------------------

model Note {
  id            String @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  matiereId String
  matiere   Matiere @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  controleId String?   @unique
  controle   Controle? @relation(fields: [controleId], references: [id], onDelete: SetNull)

  date          DateTime
  noteObtenue   Float
  noteMaximale  Float
  coefficient   Float    @default(1)
  moyenneClasse Float?
  commentaire   String?
  provenance    Provenance @default(MANUEL)
  externalId    String?

  copies Copie[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notes")
}

model Copie {
  id     String @id @default(cuid())
  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  commentaire  String?
  dateAjout    DateTime @default(now())

  documents Document[]

  @@map("copies")
}

// ---------------------------------------------------------------------------
// Contenu des chapitres (blocs)
// ---------------------------------------------------------------------------

enum TypeBloc {
  TEXTE
  FICHIER
}

// Un chapitre est une page composee de blocs ordonnes (texte enrichi ou
// fichier), reorganisables par glisser-deposer cote client. L'ordre est
// stocke via "ordre" (entiers croissants, pas necessairement contigus apres
// suppression). contenuHtml est du HTML sanitize (gras/couleur/taille).
model BlocCours {
  id         String   @id @default(cuid())
  chapitreId String
  chapitre   Chapitre @relation(fields: [chapitreId], references: [id], onDelete: Cascade)

  type        TypeBloc
  ordre       Int
  contenuHtml String?

  documentId String?   @unique
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapitreId, ordre])
  @@map("blocs_cours")
}

// Liaison many-to-many Controle <-> Chapitre
model ControleChapitre {
  controleId String
  controle   Controle @relation(fields: [controleId], references: [id], onDelete: Cascade)

  chapitreId String
  chapitre   Chapitre @relation(fields: [chapitreId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([controleId, chapitreId])
  @@map("controle_chapitres")
}

// ---------------------------------------------------------------------------
// Document (fichier physique, rattache a exactement un parent)
// ---------------------------------------------------------------------------

model Document {
  id           String @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  nomFichier   String
  typeMime     String
  tailleOctets Int
  cheminStockage String

  devoirId   String?
  devoir     Devoir?   @relation(fields: [devoirId], references: [id], onDelete: Cascade)

  controleId String?
  controle   Controle? @relation(fields: [controleId], references: [id], onDelete: Cascade)

  copieId    String?
  copie      Copie?    @relation(fields: [copieId], references: [id], onDelete: Cascade)

  blocCours BlocCours?

  createdAt DateTime @default(now())

  @@map("documents")
}

// ---------------------------------------------------------------------------
// Notifications / Rappels
// ---------------------------------------------------------------------------

model ParametreNotification {
  id            String @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  fournisseur   FournisseurNotification
  configuration Json // ex: { "topic": "..." } pour ntfy, { "userKey": "...", "appToken": "..." } pour Pushover
  actif         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("parametres_notification")
}

model Notification {
  id            String @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  // Une notification concerne soit un controle, soit un devoir (exactement un
  // des deux est renseigne).
  controleId String?
  controle   Controle? @relation(fields: [controleId], references: [id], onDelete: Cascade)

  devoirId String?
  devoir   Devoir? @relation(fields: [devoirId], references: [id], onDelete: Cascade)

  type          TypeRappel
  dateEnvoiPrevue DateTime
  datePersonnalisee DateTime?
  canaux        CanalNotification[]

  envoyee   Boolean   @default(false)
  envoyeeLe DateTime?

  createdAt DateTime @default(now())

  @@map("notifications")
}

// Rappel personnalise et recurrent, cree par l'utilisateur (ex: "Sac de sport"
// tous les lundis) : independant des devoirs et des controles. Il est envoye
// les jours choisis, a l'heure choisie, sur les canaux des rappels de devoirs
// de l'utilisateur, et affiche dans la liste des devoirs la veille et le jour meme.
model Rappel {
  id            String @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  // Matiere facultative : le rappel survit a sa suppression.
  matiereId String?
  matiere   Matiere? @relation(fields: [matiereId], references: [id], onDelete: SetNull)

  titre       String
  description String?
  jours       Int[]   // jours de la semaine, 1 = lundi ... 7 = dimanche
  heure       String  @default("07:00") // "HH:MM", dans le fuseau de l'utilisateur
  actif       Boolean @default(true)

  // Jour ("AAAA-MM-JJ", fuseau de l'utilisateur) du dernier envoi : evite les
  // doublons quand la tache planifiee repasse plusieurs fois dans la journee.
  dernierEnvoiJour String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([utilisateurId])
  @@map("rappels")
}

// ---------------------------------------------------------------------------
// Synchronisation / Journal
// ---------------------------------------------------------------------------

model Synchronisation {
  id            String @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  demarreeLe  DateTime  @default(now())
  termineeLe  DateTime?
  statut      StatutSynchronisation @default(EN_COURS)
  elementsImportes Int @default(0)
  erreurs     String?

  @@map("synchronisations")
}

model Journal {
  id            String @id @default(cuid())
  utilisateurId String?
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)

  action      String // ex: "CONNEXION", "SYNCHRONISATION", "IMPORT_DOCUMENT", "CREATION_CONTROLE", "MODIFICATION", "ERREUR"
  entiteType  String?
  entiteId    String?
  metadonnees Json?

  createdAt DateTime @default(now())

  @@map("journaux")
}

// ---------------------------------------------------------------------------
// Emploi du temps
// ---------------------------------------------------------------------------

// Seance de cours datee, importee automatiquement depuis MonBureauNumerique
// (agenda Scolengo) : tous les champs sauf contenuManuel sont entierement
// remplaces a chaque synchronisation.
model SeanceEmploiDuTemps {
  id            String @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  externalId String // identifiant Scolengo de la seance

  debut  DateTime
  fin    DateTime
  matiere    String
  titre      String?
  salle      String?
  enseignant String?
  couleur    String?
  annule     Boolean @default(false)

  // "Activite en seance" renseignee par l'enseignant sur MBN : liste de blocs
  // { id, titre, html, piecesJointes? }, remplacee entierement a chaque synchronisation.
  contenuSeance Json?

  // Note personnelle saisie par l'utilisateur quand MBN n'a rien : jamais
  // touchee par la synchronisation. A l'affichage, contenuSeance (le prof)
  // prend le dessus des qu'il existe.
  contenuManuel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([utilisateurId, externalId])
  @@index([utilisateurId, debut])
  @@map("seances_emploi_du_temps")
}

// Sessions ZITADEL fermees (deconnexion back-channel) : une session de l'app
// portant ce "sid" est refusee a la requete suivante. Purgees au-dela de la
// duree de vie d'une session de l'app (30 jours).
model SessionZitadelRevoquee {
  sid        String   @id
  revoqueeLe DateTime @default(now())

  @@index([revoqueeLe])
  @@map("sessions_zitadel_revoquees")
}
