// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  UTILISATEUR
}

enum Provenance {
  MBN
  MANUEL
}

enum StatutDevoir {
  A_FAIRE
  TERMINE
}

enum StatutControle {
  A_VENIR
  PASSE
}

enum TypeControle {
  MANUEL
  AUTOMATIQUE
}

enum CanalNotification {
  NAVIGATEUR
  EMAIL
  MOBILE
}

enum TypeRappel {
  J_MOINS_7
  J_MOINS_3
  J_MOINS_2
  VEILLE
  MATIN_MEME
  PERSONNALISE
}

enum FournisseurNotification {
  PUSHOVER
  NTFY
  GOTIFY
  AUTRE
}

enum StatutSynchronisation {
  EN_COURS
  SUCCES
  ECHEC
}

enum FrequenceSynchronisation {
  MANUELLE
  HORAIRE
  TOUTES_LES_6H
  QUOTIDIENNE
}

enum JourSemaine {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
  DIMANCHE
}

// Frequence d'un creneau d'emploi du temps : chaque semaine, ou en alternance
// (semaine impaire / semaine paire / une semaine sur quatre).
enum TypeSemaineCreneau {
  CHAQUE_SEMAINE
  SIP
  SP
  S1Q
}

// ---------------------------------------------------------------------------
// Utilisateur
// ---------------------------------------------------------------------------

model Utilisateur {
  id        String @id @default(cuid())
  zitadelSub String @unique // OIDC "sub" claim, source of truth for identity
  email     String @unique
  nom       String?
  role      Role   @default(UTILISATEUR)
  actif     Boolean @default(true)
  modeDeveloppeur Boolean @default(false)

  // Connexion MonBureauNumerique
  scolengoTokenChiffre String? // token Scolengo, stocke chiffre
  fuseauHoraire        String  @default("Europe/Paris")
  frequenceSynchronisation FrequenceSynchronisation @default(MANUELLE)

  // Detection automatique des controles (mots-cles configurables par utilisateur)
  motsClesControle String[] @default(["controle", "controle", "evaluation", "evaluation", "interrogation", "interro", "devoir surveille", "ds", "examen", "test", "quiz"])

  // Rappels generes automatiquement pour chaque nouveau controle (section 8)
  rappelsParDefaut TypeRappel[]        @default([J_MOINS_3, VEILLE])
  canauxParDefaut  CanalNotification[] @default([EMAIL, MOBILE])

  // Rappels generes automatiquement pour chaque devoir non termine.
  // Par defaut : 2 jours avant, la veille (18h) et le matin meme (6h30).
  rappelsDevoirParDefaut TypeRappel[]        @default([J_MOINS_2, VEILLE, MATIN_MEME])
  canauxDevoirParDefaut  CanalNotification[] @default([EMAIL, MOBILE])

  preferencesAffichage Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matieres          Matiere[]
  devoirs           Devoir[]
  controles         Controle[]
  notes             Note[]
  chapitres         Chapitre[]
  notifications     Notification[]
  parametresNotif   ParametreNotification[]
  synchronisations  Synchronisation[]
  journaux          Journal[]
  documents         Document[]

  // Son propre emploi du temps (au plus un).
  emploiDuTempsPropre EmploiDuTemps? @relation("EmploiDuTempsPropre")
  // Emplois du temps de personnes sans compte, qu'il gere.
  emploisDuTempsGeres EmploiDuTemps[] @relation("EmploiDuTempsGere")

  @@map("utilisateurs")
}

// Email pre-autorise par un administrateur : aucun formulaire d'inscription
// n'existe, mais l'authentification ZITADEL a elle seule ne suffit pas a
// obtenir un compte local tant que l'email n'a pas ete ajoute ici (sauf pour
// l'admin initial). L'entree est consommee (supprimee) a la premiere connexion.
model EmailAutorise {
  id        String   @id @default(cuid())
  email     String   @unique
  role      Role     @default(UTILISATEUR)
  ajoutePar String?
  createdAt DateTime @default(now())

  @@map("emails_autorises")
}

// ---------------------------------------------------------------------------
// Matiere / Chapitre
// ---------------------------------------------------------------------------

model Matiere {
  id            String @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  nom       String
  couleur   String?
  externalId String? // identifiant MBN pour reconciliation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devoirs   Devoir[]
  controles Controle[]
  notes     Note[]
  chapitres Chapitre[]

  @@unique([utilisateurId, nom])
  @@map("matieres")
}

// Le chapitre EST la page de contenu (composee de blocs ordonnes), plutot
// qu'un simple regroupement de "cours" separes.
model Chapitre {
  id            String @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  matiereId String
  matiere   Matiere @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  nom String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blocs     BlocCours[]
  controles ControleChapitre[]

  @@unique([matiereId, nom])
  @@map("chapitres")
}

// ---------------------------------------------------------------------------
// Devoir
// ---------------------------------------------------------------------------

model Devoir {
  id            String @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  matiereId String
  matiere   Matiere @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  enseignant  String?
  date        DateTime
  heure       String?
  titre       String
  description String?
  statut      StatutDevoir @default(A_FAIRE)
  provenance  Provenance   @default(MANUEL)
  externalId  String?      // identifiant MBN pour reconciliation lors des sync

  // Lorsqu'un mot-cle est detecte, le devoir donne naissance a un Controle.
  controleGenere Controle?

  documents Document[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("devoirs")
}

// ---------------------------------------------------------------------------
// Controle
// ---------------------------------------------------------------------------

model Controle {
  id            String @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  matiereId String
  matiere   Matiere @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  // Present uniquement si le controle a ete genere depuis un devoir synchronise.
  devoirSourceId String? @unique
  devoirSource   Devoir? @relation(fields: [devoirSourceId], references: [id], onDelete: SetNull)

  date       DateTime
  heure      String?
  chapitreLibre String? // libelle de chapitre libre, distinct de la bibliotheque de cours
  commentaire   String?
  statut     StatutControle @default(A_VENIR)
  type       TypeControle   @default(MANUEL)

  note      Note?
  chapitres ControleChapitre[]
  documents Document[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("controles")
}

// ---------------------------------------------------------------------------
// Note / Copie
// ---------------------------------------------------------------------------

model Note {
  id            String @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  matiereId String
  matiere   Matiere @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  controleId String?   @unique
  controle   Controle? @relation(fields: [controleId], references: [id], onDelete: SetNull)

  date          DateTime
  noteObtenue   Float
  noteMaximale  Float
  coefficient   Float    @default(1)
  moyenneClasse Float?
  commentaire   String?
  provenance    Provenance @default(MANUEL)
  externalId    String?

  copies Copie[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notes")
}

model Copie {
  id     String @id @default(cuid())
  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  commentaire  String?
  dateAjout    DateTime @default(now())

  documents Document[]

  @@map("copies")
}

// ---------------------------------------------------------------------------
// Contenu des chapitres (blocs)
// ---------------------------------------------------------------------------

enum TypeBloc {
  TEXTE
  FICHIER
}

// Un chapitre est une page composee de blocs ordonnes (texte enrichi ou
// fichier), reorganisables par glisser-deposer cote client. L'ordre est
// stocke via "ordre" (entiers croissants, pas necessairement contigus apres
// suppression). contenuHtml est du HTML sanitize (gras/couleur/taille).
model BlocCours {
  id         String   @id @default(cuid())
  chapitreId String
  chapitre   Chapitre @relation(fields: [chapitreId], references: [id], onDelete: Cascade)

  type        TypeBloc
  ordre       Int
  contenuHtml String?

  documentId String?   @unique
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapitreId, ordre])
  @@map("blocs_cours")
}

// Liaison many-to-many Controle <-> Chapitre
model ControleChapitre {
  controleId String
  controle   Controle @relation(fields: [controleId], references: [id], onDelete: Cascade)

  chapitreId String
  chapitre   Chapitre @relation(fields: [chapitreId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([controleId, chapitreId])
  @@map("controle_chapitres")
}

// ---------------------------------------------------------------------------
// Document (fichier physique, rattache a exactement un parent)
// ---------------------------------------------------------------------------

model Document {
  id           String @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  nomFichier   String
  typeMime     String
  tailleOctets Int
  cheminStockage String

  devoirId   String?
  devoir     Devoir?   @relation(fields: [devoirId], references: [id], onDelete: Cascade)

  controleId String?
  controle   Controle? @relation(fields: [controleId], references: [id], onDelete: Cascade)

  copieId    String?
  copie      Copie?    @relation(fields: [copieId], references: [id], onDelete: Cascade)

  blocCours BlocCours?

  createdAt DateTime @default(now())

  @@map("documents")
}

// ---------------------------------------------------------------------------
// Notifications / Rappels
// ---------------------------------------------------------------------------

model ParametreNotification {
  id            String @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  fournisseur   FournisseurNotification
  configuration Json // ex: { "topic": "..." } pour ntfy, { "userKey": "...", "appToken": "..." } pour Pushover
  actif         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("parametres_notification")
}

model Notification {
  id            String @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  // Une notification concerne soit un controle, soit un devoir (exactement un
  // des deux est renseigne).
  controleId String?
  controle   Controle? @relation(fields: [controleId], references: [id], onDelete: Cascade)

  devoirId String?
  devoir   Devoir? @relation(fields: [devoirId], references: [id], onDelete: Cascade)

  type          TypeRappel
  dateEnvoiPrevue DateTime
  datePersonnalisee DateTime?
  canaux        CanalNotification[]

  envoyee   Boolean   @default(false)
  envoyeeLe DateTime?

  createdAt DateTime @default(now())

  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Synchronisation / Journal
// ---------------------------------------------------------------------------

model Synchronisation {
  id            String @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  demarreeLe  DateTime  @default(now())
  termineeLe  DateTime?
  statut      StatutSynchronisation @default(EN_COURS)
  elementsImportes Int @default(0)
  erreurs     String?

  @@map("synchronisations")
}

model Journal {
  id            String @id @default(cuid())
  utilisateurId String?
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)

  action      String // ex: "CONNEXION", "SYNCHRONISATION", "IMPORT_DOCUMENT", "CREATION_CONTROLE", "MODIFICATION", "ERREUR"
  entiteType  String?
  entiteId    String?
  metadonnees Json?

  createdAt DateTime @default(now())

  @@map("journaux")
}

// ---------------------------------------------------------------------------
// Emploi du temps
// ---------------------------------------------------------------------------

// Un emploi du temps appartient soit a un compte existant (utilisateurId, au
// plus un par compte), soit a une personne sans compte creee manuellement
// (nomPersonne + gerePar, le compte qui la gere). Tous les utilisateurs
// connectes peuvent consulter n'importe quel emploi du temps ; seuls le
// titulaire du compte ou le gestionnaire (et les administrateurs) peuvent le
// modifier.
model EmploiDuTemps {
  id String @id @default(cuid())

  utilisateurId String?      @unique
  utilisateur   Utilisateur? @relation("EmploiDuTempsPropre", fields: [utilisateurId], references: [id], onDelete: Cascade)

  nomPersonne String?
  gerePar     String?
  gestionnaire Utilisateur? @relation("EmploiDuTempsGere", fields: [gerePar], references: [id], onDelete: Cascade)

  creneaux CreneauEdt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("emplois_du_temps")
}

model CreneauEdt {
  id              String        @id @default(cuid())
  emploiDuTempsId String
  emploiDuTemps   EmploiDuTemps @relation(fields: [emploiDuTempsId], references: [id], onDelete: Cascade)

  jour       JourSemaine
  heureDebut String // "08:00"
  heureFin   String // "09:00"

  matiere    String
  enseignant String?
  salle      String?
  couleur    String?

  typeSemaine TypeSemaineCreneau @default(CHAQUE_SEMAINE)
  rangS1Q     Int? // 1 a 4, utilise uniquement si typeSemaine = S1Q

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([emploiDuTempsId, jour])
  @@map("creneaux_edt")
}
